{
  "Workers": {
    "SocketDirectory": "/run/modular-monolith",
    "StartupTimeoutSeconds": 20,
    "ShutdownGracePeriod": 10
  },
  "ImageCache": {
    "DatabasePath": "/var/lib/modular-monolith/image-cache.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
