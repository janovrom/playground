<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModularMonolith.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <ProjectReference Include="..\ModularMonolith.Contracts\ModularMonolith.Contracts.csproj" />
    <ProjectReference Include="..\ModularMonolith.Platform\ModularMonolith.Platform.csproj" />
    <ProjectReference Include="..\ModularMonolith.Generators\ModularMonolith.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishTrimmed;PublishAot" />
    <ProjectReference Include="..\ModularMonolith.Worker.SvgRenderer\ModularMonolith.Worker.SvgRenderer.csproj"
                      ReferenceOutputAssembly="false"
                      BuildReference="false"
                      Private="false"
                      PackageAsWorker="true" />
    <ProjectReference Include="..\ModularMonolith.Worker.ImageCache\ModularMonolith.Worker.ImageCache.csproj"
                      ReferenceOutputAssembly="false"
                      BuildReference="false"
                      Private="false"
                      PackageAsWorker="true" />
  </ItemGroup>

  <!-- Packaging targets select direct project references marked with PackageAsWorker. -->
  <ItemGroup>
    <WorkerProject Include="@(ProjectReference)" />
  </ItemGroup>

  <!-- Build every selected worker, then copy its complete output below workers/<ProjectName>. -->
  <Target Name="CopyWorkerOutputs" AfterTargets="Build" Condition="'@(WorkerProject)' != ''">
    <RemoveDir Directories="$(OutDir)workers" />

    <MSBuild
      Projects="@(WorkerProject)"
      Targets="Build;GetTargetPath"
      Properties="Configuration=$(Configuration)"
      BuildInParallel="$(BuildInParallel)"
      Condition="'%(WorkerProject.PackageAsWorker)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkerAssembly" />
    </MSBuild>

    <CreateItem
      Include="%(_WorkerAssembly.RootDir)%(_WorkerAssembly.Directory)**\*"
      AdditionalMetadata="WorkerProject=%(_WorkerAssembly.Filename)">
      <Output TaskParameter="Include" ItemName="_WorkerBuildFile" />
    </CreateItem>

    <MakeDir Directories="@(_WorkerAssembly->'$(OutDir)workers\%(Filename)')" />
    <Copy
      SourceFiles="@(_WorkerBuildFile)"
      DestinationFiles="@(_WorkerBuildFile->'$(OutDir)workers\%(WorkerProject)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish every selected worker with the Host publication mode into the distribution bundle. -->
  <Target Name="CopyPublishedWorkerOutputs" AfterTargets="Publish" Condition="'@(WorkerProject)' != ''">
    <RemoveDir Directories="$(PublishDir)workers" />

    <MSBuild
      Projects="@(WorkerProject)"
      Targets="Publish"
      BuildInParallel="$(BuildInParallel)"
      Condition="'%(WorkerProject.PackageAsWorker)' == 'true'"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);UseAppHost=$(UseAppHost);PublishTrimmed=$(PublishTrimmed);PublishAot=$(PublishAot);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)workers\%(WorkerProject.Filename)\'))" />
  </Target>

</Project>
