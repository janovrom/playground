{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test: linux",
      "type": "shell",
      "command": "tools/dotnet-container/run.sh test modular-monolith/ModularMonolith.slnx",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: windows (wine)",
      "type": "shell",
      "command": "tools/dotnet-container/run.sh wine-test modular-monolith/ModularMonolith.slnx -c Release",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: windows publish (Host)",
      "type": "shell",
      "command": "tools/dotnet-container/run.sh publish-win modular-monolith/src/ModularMonolith.Host",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
